---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '归档' },
  { href: '/search/', label: '搜索' },
  { href: '/about/', label: '关于' },
];
---

<header class="site-header">
  <div class="container">
    <a class="site-title" href="/">{SITE_TITLE}</a>
    <nav class="site-nav">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[{ active: item.href === '/' ? pathname === '/' : pathname.startsWith(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
