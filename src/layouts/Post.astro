---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import { tagSlug } from '../utils/tags';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
  toc?: MarkdownHeading[];
}

const { post, prev, next, toc = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

// 中文按 400 字/分钟、拉丁词按 200 词/分钟估算
const body = post.body ?? '';
const cjkChars = (body.match(/[\u4e00-\u9fff]/g) ?? []).length;
const latinWords = (body.match(/[a-zA-Z0-9]+/g) ?? []).length;
const readingMinutes = Math.max(1, Math.round(cjkChars / 400 + latinWords / 200));
---

<Base title={title} description={description} ogType="article" publishedTime={pubDate.toISOString()}>
  <article>
    <header class="post-header">
      <h1 transition:name={`post-title-${post.id}`}>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>更新于 {formatDate(updatedDate)}</span>}
        <span>约 {readingMinutes} 分钟</span>
        {tags.map((tag) => (
          <a class="tag" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
        ))}
      </div>
    </header>

    {
      toc.length > 0 && (
        <details class="toc" aria-label="文章大纲">
          <summary>
            <span class="toc-title">大纲</span>
          </summary>
          <ol>
            {toc.map((h) => (
              <li class={`toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="post-body">
      <slot />
    </div>

    <nav class="post-nav">
      {prev ? <a href={`/blog/${prev.id}/`}>← {prev.title}</a> : <span />}
      {next ? <a href={`/blog/${next.id}/`}>{next.title} →</a> : <span />}
    </nav>

    <Comments />
  </article>
</Base>

<script>
  let tocObserver: IntersectionObserver | undefined;
  let tocMq: MediaQueryList | undefined;
  let tocMqBound = false;

  function initToc() {
    tocObserver?.disconnect();

    const toc = document.querySelector<HTMLDetailsElement>('.toc');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc a');

    // 宽屏侧栏始终展开，窄屏折叠由读者自行开关
    if (toc) {
      tocMq ??= window.matchMedia('(min-width: 74rem)');
      if (!tocMqBound) {
        tocMqBound = true;
        tocMq.addEventListener('change', (e) => {
          const el = document.querySelector<HTMLDetailsElement>('.toc');
          if (el) el.open = e.matches;
        });
      }
      toc.open = tocMq.matches;
    }

    if (tocLinks.length === 0) return;

    if (toc && !toc.dataset.clickBound) {
      toc.dataset.clickBound = '1';
      toc.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a');
        if (!a || !a.hash) return;
        const id = decodeURIComponent(a.hash.slice(1));
        const el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto' });
        history.replaceState(null, '', a.hash);
      });
    }

    const byId = new Map<string, HTMLAnchorElement>();
    tocLinks.forEach((a) => byId.set(decodeURIComponent(a.hash.slice(1)), a));

    tocObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = byId.get(entry.target.id);
          if (link && entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove('active'));
            link.classList.add('active');
          }
        });
      },
      { rootMargin: '0px 0px -75% 0px' },
    );

    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) tocObserver!.observe(el);
    });
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>

<script>
  // —— 图片灯箱：点击正文图片放大查看，点击遮罩 / Esc 关闭 ——
  let overlay: HTMLDivElement | null = null;

  function closeLightbox() {
    overlay?.remove();
    overlay = null;
    document.documentElement.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const img = (e.target as Element).closest?.('.post-body img');
    if (!img) {
      if (overlay && e.target === overlay) closeLightbox();
      return;
    }
    e.preventDefault();
    overlay?.remove();
    overlay = document.createElement('div');
    overlay.className = 'lightbox';
    const clone = document.createElement('img');
    clone.src = (img as HTMLImageElement).src;
    clone.alt = (img as HTMLImageElement).alt;
    overlay.appendChild(clone);
    document.body.appendChild(overlay);
    document.documentElement.style.overflow = 'hidden';
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  document.addEventListener('astro:after-swap', closeLightbox);
</script>
